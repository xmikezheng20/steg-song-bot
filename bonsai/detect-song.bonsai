<?xml version="1.0" ?>
<WorkflowBuilder xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:al="clr-namespace:Bonsai.Audio;assembly=Bonsai.Audio" xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp" xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core" xmlns:s="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions" xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System" xmlns="https://bonsai-rx.org/2018/workflow" Version="2.9.1">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="al:AudioCapture">
          <al:DeviceName>Microphone (250kHz AudioMoth US</al:DeviceName>
          <al:SampleRate>250000</al:SampleRate>
          <al:SampleFormat>Mono16</al:SampleFormat>
          <al:BufferLength>10</al:BufferLength>
        </Combinator>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="BandEnergy.bonsai"/>
      <Expression xsi:type="IncludeWorkflow" Path="SongState.bonsai"/>
      <Expression xsi:type="IncludeWorkflow" Path="LogDetection.bonsai"/>
      <Expression xsi:type="Condition">
        <Name>RecordRawAudio</Name>
        <Description>Set Boolean Value before running. True records raw audio; false keeps detection and CSV only. Do not change during a session.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="BooleanProperty">
                <Value>true</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput"/>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1"/>
            <Edge From="1" To="2" Label="Source1"/>
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:WindowCount">
          <rx:Count>360000</rx:Count>
          <rx:Skip xsi:nil="true"/>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:SelectMany">
        <Name>WriteWav</Name>
        <Description>Hourly raw PCM16. Set the output path before each session.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="al:AudioWriter">
                <al:FileName>../recordings/audio.wav</al:FileName>
                <al:Suffix>Timestamp</al:Suffix>
                <al:Buffered>true</al:Buffered>
                <al:Overwrite>false</al:Overwrite>
                <al:SampleRate>250000</al:SampleRate>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput"/>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1"/>
            <Edge From="1" To="2" Label="Source1"/>
          </Edges>
        </Workflow>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1"/>
      <Edge From="1" To="2" Label="Source1"/>
      <Edge From="2" To="3" Label="Source1"/>
      <Edge From="0" To="4" Label="Source1"/>
      <Edge From="4" To="5" Label="Source1"/>
      <Edge From="5" To="6" Label="Source1"/>
    </Edges>
  </Workflow>
</WorkflowBuilder>
