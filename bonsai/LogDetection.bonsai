        <io:Overwrite>false</io:Overwrite>
        <io:Suffix>Timestamp</io:Suffix>
        <io:IncludeHeader>true</io:IncludeHeader>
      </Expression>
      <Expression xsi:type="Condition">
        <Name>EventsOnly</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Event</Selector>
            </Expression>
            <Expression xsi:type="NotEqual">
              <Operand xsi:type="StringProperty">
                <Value/>
              </Operand>
            </Expression>
            <Expression xsi:type="WorkflowOutput"/>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1"/>
            <Edge From="1" To="2" Label="Source1"/>
            <Edge From="2" To="3" Label="Source1"/>
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:TakeLast">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>StreamEnd</Name>
        <Description/>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>State</Selector>
            </Expression>
            <Expression xsi:type="Equal">
              <Operand xsi:type="StringProperty">
                <Value>Idle</Value>
              </Operand>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="StringProperty">
                <Value>stream_end</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="StringProperty">
                <Value>incomplete</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip"/>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>TerminalEvent</Name>
              <Description>Select the true or false branch once per input. Native Condition and Merge.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="Condition">
                    <Name>WhenTrue</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item1</Selector>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput"/>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1"/>
                        <Edge From="1" To="2" Label="Source1"/>
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item2</Selector>
                  </Expression>
                  <Expression xsi:type="Condition">
                    <Name>WhenFalse</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item1</Selector>
                        </Expression>
                        <Expression xsi:type="BitwiseNot"/>
                        <Expression xsi:type="WorkflowOutput"/>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1"/>
                        <Edge From="1" To="2" Label="Source1"/>
                        <Edge From="2" To="3" Label="Source1"/>
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item3</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Merge"/>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput"/>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1"/>
                  <Edge From="1" To="2" Label="Source1"/>
                  <Edge From="0" To="3" Label="Source1"/>
                  <Edge From="3" To="4" Label="Source1"/>
                  <Edge From="2" To="5" Label="Source1"/>
                  <Edge From="4" To="5" Label="Source2"/>
                  <Edge From="5" To="6" Label="Source1"/>
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>BlockIndex</Selector>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>StartSample</Selector>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>EndSample</Selector>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Rms</Selector>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Active</Selector>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>State</Selector>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>CandidateId</Selector>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>OnsetSample</Selector>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>OffsetSample</Selector>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>SpanSeconds</Selector>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Occupancy</Selector>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>ProcessedUtc</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip"/>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip"/>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip"/>
            </Expression>
            <Expression xsi:type="s:ExpressionTransform">
              <s:Name>LabelFields</s:Name>
              <s:Description>Field names only; no decisions or parameters.</s:Description>
              <s:Expression>new(Item1.Item1 as BlockIndex, Item1.Item2 as StartSample, Item1.Item3 as EndSample, Item1.Item4 as Rms, Item1.Item5 as Active, Item1.Item6 as State, Item1.Item7 as CandidateId, Item2.Item1 as OnsetSample, Item2.Item2 as OffsetSample, Item2.Item3 as SpanSeconds, Item2.Item4 as Occupancy, Item2.Item5 as Event, Item2.Item6 as ProcessedUtc)</s:Expression>
            </Expression>
            <Expression xsi:type="WorkflowOutput"/>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1"/>
            <Edge From="1" To="2" Label="Source1"/>
            <Edge From="0" To="3" Label="Source1"/>
            <Edge From="0" To="4" Label="Source1"/>
            <Edge From="2" To="5" Label="Source1"/>
