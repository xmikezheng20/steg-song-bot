        <s:Description>Field names only; no decisions or parameters.</s:Description>
        <s:Expression>new(Item2.BlockIndex as BlockIndex, Item1.Item1 as Rms, Item1.Item2 as Active, Item2.CandidateId as CandidateId, Item2.OnsetBlock as OnsetBlock, Item2.LastActiveEndBlock as LastActiveEndBlock, Item2.ActiveBlocks as ActiveBlocks, Item2.Confirmed as Confirmed, Item2.Event as Event)</s:Expression>
