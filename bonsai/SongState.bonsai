            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>ConfirmSong</Name>
              <Description>Active AND not already confirmed AND sufficient span AND sufficient occupancy.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item4</Selector>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item3</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="Subtract"/>
                  <Expression xsi:type="GreaterThanOrEqual">
                    <Operand xsi:type="Int64Property">
                      <Value>100</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="Value" DisplayName="MinSpanBlocks" Description="Minimum candidate span in 10-ms blocks."/>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item5</Selector>
                  </Expression>
                  <Expression xsi:type="Multiply">
                    <Operand xsi:type="DoubleProperty">
                      <Value>1.0</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="Divide"/>
                  <Expression xsi:type="GreaterThanOrEqual">
                    <Operand xsi:type="DoubleProperty">
                      <Value>0.2</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="Value" DisplayName="MinOccupancy" Description="Active blocks / candidate span; from 0 to 1."/>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item7</Selector>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item6</Selector>
                  </Expression>
                  <Expression xsi:type="BitwiseNot"/>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="LogicalAnd"/>
                  <Expression xsi:type="WorkflowOutput"/>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1"/>
                  <Edge From="0" To="2" Label="Source1"/>
                  <Edge From="1" To="3" Label="Source1"/>
                  <Edge From="2" To="3" Label="Source2"/>
                  <Edge From="3" To="4" Label="Source1"/>
                  <Edge From="4" To="5" Label="Source1"/>
                  <Edge From="6" To="5" Label="Source1"/>
                  <Edge From="0" To="7" Label="Source1"/>
                  <Edge From="7" To="8" Label="Source1"/>
                  <Edge From="8" To="9" Label="Source1"/>
                  <Edge From="4" To="9" Label="Source2"/>
                  <Edge From="9" To="10" Label="Source1"/>
                  <Edge From="10" To="11" Label="Source1"/>
                  <Edge From="12" To="11" Label="Source1"/>
                  <Edge From="0" To="13" Label="Source1"/>
                  <Edge From="0" To="14" Label="Source1"/>
                  <Edge From="14" To="15" Label="Source1"/>
                  <Edge From="13" To="16" Label="Source1"/>
                  <Edge From="15" To="16" Label="Source2"/>
