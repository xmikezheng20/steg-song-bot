            <Expression xsi:type="s:ExpressionTransform">
              <s:Name>LabelFields</s:Name>
              <s:Description>Field names only; no decisions or parameters.</s:Description>
              <s:Expression>new(Item1 as BlockIndex, Item2 as CandidateId, Item3 as OnsetBlock, Item4 as LastActiveEndBlock, Item5 as ActiveBlocks, Item6 as Confirmed, Item7 as Event)</s:Expression>
            </Expression>
            <Expression xsi:type="WorkflowOutput"/>
