<?xml version="1.0" ?>
<WorkflowBuilder xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core" xmlns:s="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions" xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System" xmlns="https://bonsai-rx.org/2018/workflow" Version="2.9.1">
  <Workflow>
    <Nodes>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="GreaterThan">
        <Operand xsi:type="DoubleProperty">
          <Value>0.01</Value>
        </Operand>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Value" DisplayName="Threshold" Description="Fixed full-scale RMS threshold."/>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip"/>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Range">
          <rx:Start>0</rx:Start>
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>InitialState</Name>
        <Description>Fresh counters for every subscription; these are initialization values, not detector settings.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="Int64Property">
                <Value>0</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="Int64Property">
                <Value>-1</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="BooleanProperty">
                <Value>false</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="StringProperty">
                <Value/>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip"/>
            </Expression>
            <Expression xsi:type="s:ExpressionTransform">
              <s:Name>LabelFields</s:Name>
              <s:Description>Field names only; no decisions or parameters.</s:Description>
              <s:Expression>new(Item1 as BlockIndex, Item2 as CandidateId, Item3 as OnsetBlock, Item4 as LastActiveEndBlock, Item5 as ActiveBlocks, Item6 as Confirmed, Item7 as Event)</s:Expression>
            </Expression>
            <Expression xsi:type="WorkflowOutput"/>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1"/>
            <Edge From="0" To="2" Label="Source1"/>
            <Edge From="0" To="3" Label="Source1"/>
            <Edge From="0" To="4" Label="Source1"/>
            <Edge From="2" To="5" Label="Source1"/>
            <Edge From="1" To="5" Label="Source2"/>
            <Edge From="2" To="5" Label="Source3"/>
            <Edge From="2" To="5" Label="Source4"/>
            <Edge From="1" To="5" Label="Source5"/>
            <Edge From="3" To="5" Label="Source6"/>
            <Edge From="4" To="5" Label="Source7"/>
            <Edge From="5" To="6" Label="Source1"/>
            <Edge From="6" To="7" Label="Source1"/>
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="rx:Scan">
        <Name>SongState</Name>
        <Description>Synchronous native counters, comparisons and conditional branches.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>UpdateCandidate</Name>
              <Description/>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Accumulation</Selector>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Value</Selector>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>BlockIndex</Selector>
                  </Expression>
                  <Expression xsi:type="Add">
                    <Operand xsi:type="Int64Property">
                      <Value>1</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item2</Selector>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>OnsetBlock</Selector>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>LastActiveEndBlock</Selector>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Event</Selector>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>ActiveBlocks</Selector>
                  </Expression>
                  <Expression xsi:type="GreaterThanOrEqual">
                    <Operand xsi:type="Int64Property">
                      <Value>0</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="NotEqual">
                    <Operand xsi:type="StringProperty">
                      <Value>completed</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="NotEqual">
                    <Operand xsi:type="StringProperty">
                      <Value>rejected</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="LogicalAnd"/>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="Int64Property">
                      <Value>0</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="Int64Property">
                      <Value>1</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="Int64Property">
                      <Value>-1</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="BitwiseNot"/>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="LogicalAnd"/>
                  <Expression xsi:type="MemberSelector">
                    <Selector>CandidateId</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>NewCandidate</Name>
                    <Description>Select the true or false branch once per input. Native Condition and Merge.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="Condition">
                          <Name>WhenTrue</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput"/>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1"/>
                              <Edge From="1" To="2" Label="Source1"/>
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2</Selector>
                        </Expression>
                        <Expression xsi:type="Condition">
                          <Name>WhenFalse</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="BitwiseNot"/>
                              <Expression xsi:type="WorkflowOutput"/>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1"/>
                              <Edge From="1" To="2" Label="Source1"/>
                              <Edge From="2" To="3" Label="Source1"/>
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item3</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Merge"/>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput"/>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1"/>
                        <Edge From="1" To="2" Label="Source1"/>
                        <Edge From="0" To="3" Label="Source1"/>
                        <Edge From="3" To="4" Label="Source1"/>
                        <Edge From="2" To="5" Label="Source1"/>
                        <Edge From="4" To="5" Label="Source2"/>
                        <Edge From="5" To="6" Label="Source1"/>
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="Add"/>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>FirstActiveBlock</Name>
                    <Description>Select the true or false branch once per input. Native Condition and Merge.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="Condition">
                          <Name>WhenTrue</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput"/>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1"/>
                              <Edge From="1" To="2" Label="Source1"/>
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2</Selector>
                        </Expression>
                        <Expression xsi:type="Condition">
                          <Name>WhenFalse</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="BitwiseNot"/>
                              <Expression xsi:type="WorkflowOutput"/>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1"/>
                              <Edge From="1" To="2" Label="Source1"/>
                              <Edge From="2" To="3" Label="Source1"/>
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item3</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Merge"/>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput"/>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1"/>
                        <Edge From="1" To="2" Label="Source1"/>
                        <Edge From="0" To="3" Label="Source1"/>
                        <Edge From="3" To="4" Label="Source1"/>
                        <Edge From="2" To="5" Label="Source1"/>
                        <Edge From="4" To="5" Label="Source2"/>
                        <Edge From="5" To="6" Label="Source1"/>
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>CandidateOnset</Name>
                    <Description>Select the true or false branch once per input. Native Condition and Merge.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="Condition">
                          <Name>WhenTrue</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput"/>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1"/>
                              <Edge From="1" To="2" Label="Source1"/>
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2</Selector>
                        </Expression>
                        <Expression xsi:type="Condition">
                          <Name>WhenFalse</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="BitwiseNot"/>
                              <Expression xsi:type="WorkflowOutput"/>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1"/>
                              <Edge From="1" To="2" Label="Source1"/>
                              <Edge From="2" To="3" Label="Source1"/>
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item3</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Merge"/>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput"/>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1"/>
                        <Edge From="1" To="2" Label="Source1"/>
                        <Edge From="0" To="3" Label="Source1"/>
                        <Edge From="3" To="4" Label="Source1"/>
                        <Edge From="2" To="5" Label="Source1"/>
                        <Edge From="4" To="5" Label="Source2"/>
                        <Edge From="5" To="6" Label="Source1"/>
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Add">
                    <Operand xsi:type="Int64Property">
                      <Value>1</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>KeepLastActive</Name>
                    <Description>Select the true or false branch once per input. Native Condition and Merge.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="Condition">
                          <Name>WhenTrue</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput"/>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1"/>
                              <Edge From="1" To="2" Label="Source1"/>
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2</Selector>
                        </Expression>
                        <Expression xsi:type="Condition">
                          <Name>WhenFalse</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="BitwiseNot"/>
                              <Expression xsi:type="WorkflowOutput"/>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1"/>
                              <Edge From="1" To="2" Label="Source1"/>
                              <Edge From="2" To="3" Label="Source1"/>
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item3</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Merge"/>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput"/>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1"/>
                        <Edge From="1" To="2" Label="Source1"/>
                        <Edge From="0" To="3" Label="Source1"/>
                        <Edge From="3" To="4" Label="Source1"/>
                        <Edge From="2" To="5" Label="Source1"/>
                        <Edge From="4" To="5" Label="Source2"/>
                        <Edge From="5" To="6" Label="Source1"/>
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>LastActiveEnd</Name>
                    <Description>Select the true or false branch once per input. Native Condition and Merge.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="Condition">
                          <Name>WhenTrue</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput"/>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1"/>
                              <Edge From="1" To="2" Label="Source1"/>
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2</Selector>
                        </Expression>
                        <Expression xsi:type="Condition">
                          <Name>WhenFalse</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="BitwiseNot"/>
                              <Expression xsi:type="WorkflowOutput"/>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1"/>
                              <Edge From="1" To="2" Label="Source1"/>
                              <Edge From="2" To="3" Label="Source1"/>
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item3</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Merge"/>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput"/>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1"/>
                        <Edge From="1" To="2" Label="Source1"/>
                        <Edge From="0" To="3" Label="Source1"/>
                        <Edge From="3" To="4" Label="Source1"/>
                        <Edge From="2" To="5" Label="Source1"/>
                        <Edge From="4" To="5" Label="Source2"/>
                        <Edge From="5" To="6" Label="Source1"/>
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>ResetActiveCount</Name>
                    <Description>Select the true or false branch once per input. Native Condition and Merge.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="Condition">
                          <Name>WhenTrue</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput"/>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1"/>
                              <Edge From="1" To="2" Label="Source1"/>
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2</Selector>
                        </Expression>
                        <Expression xsi:type="Condition">
                          <Name>WhenFalse</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="BitwiseNot"/>
                              <Expression xsi:type="WorkflowOutput"/>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1"/>
                              <Edge From="1" To="2" Label="Source1"/>
                              <Edge From="2" To="3" Label="Source1"/>
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item3</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Merge"/>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput"/>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1"/>
                        <Edge From="1" To="2" Label="Source1"/>
                        <Edge From="0" To="3" Label="Source1"/>
                        <Edge From="3" To="4" Label="Source1"/>
                        <Edge From="2" To="5" Label="Source1"/>
                        <Edge From="4" To="5" Label="Source2"/>
                        <Edge From="5" To="6" Label="Source1"/>
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>CountActiveBlock</Name>
                    <Description>Select the true or false branch once per input. Native Condition and Merge.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="Condition">
                          <Name>WhenTrue</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput"/>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1"/>
                              <Edge From="1" To="2" Label="Source1"/>
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2</Selector>
                        </Expression>
                        <Expression xsi:type="Condition">
                          <Name>WhenFalse</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="BitwiseNot"/>
                              <Expression xsi:type="WorkflowOutput"/>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1"/>
                              <Edge From="1" To="2" Label="Source1"/>
                              <Edge From="2" To="3" Label="Source1"/>
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item3</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Merge"/>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput"/>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1"/>
                        <Edge From="1" To="2" Label="Source1"/>
                        <Edge From="0" To="3" Label="Source1"/>
                        <Edge From="3" To="4" Label="Source1"/>
                        <Edge From="2" To="5" Label="Source1"/>
                        <Edge From="4" To="5" Label="Source2"/>
                        <Edge From="5" To="6" Label="Source1"/>
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="Add"/>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Confirmed</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="LogicalAnd"/>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip"/>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput"/>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1"/>
                  <Edge From="0" To="2" Label="Source1"/>
                  <Edge From="1" To="3" Label="Source1"/>
