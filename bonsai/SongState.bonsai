            <Expression xsi:type="ExternalizedMapping">
              <Property Name="MinSpanBlocks" DisplayName="MinSpanBlocks" Description=""/>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="MinOccupancy" DisplayName="MinOccupancy" Description=""/>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="QuietBlocks" DisplayName="QuietBlocks" Description=""/>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item6</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip"/>
            </Expression>
            <Expression xsi:type="LogicalOr"/>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="StringProperty">
                <Value>completed</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="StringProperty">
                <Value>rejected</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="StringProperty">
                <Value>confirmed</Value>
              </Combinator>
